#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <13 14>;
            layers = <7 8>;
        };

        mac_layout {
            bindings = <&to 1>;
            key-positions = <13 14>;
            layers = <0>;
        };

        win_layout {
            bindings = <&to 0>;
            key-positions = <13 14>;
            layers = <1>;
        };

        left_kakko {
            bindings = <&kp LS(N8)>;
            key-positions = <20 19>;
            layers = <0 1>;
        };

        right_kakko {
            bindings = <&kp LS(N9)>;
            key-positions = <20 21>;
            layers = <0 1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        //　Windowsのレイヤー設定

        layer_0 {
            bindings = <
&none  &none              &none     &none     &none       &none                                   &none       &none  &none      &none     &none                 &none
&none  &kp Q              &kp W     &kp E     &kp R       &kp T                                   &kp Y       &kp U  &kp I      &kp O     &kp P                 &none
&none  &kp A              &kp S     &kp D     &kp F       &kp G        &none       &none          &kp H       &kp J  &kp K      &kp L     &lt 7 ENTER           &none
&none  &mt RIGHT_SHIFT Z  &kp X     &kp C     &kp V       &kp B        &kp ESC     &kp DELETE     &kp N       &kp M  &kp COMMA  &kp DOT   &mt RIGHT_SHIFT FSLH  &none
&none  &kp LCTRL          &kp LGUI  &kp LALT  &lt 3 BSPC  &lt 4 SPACE  &lt 6 CAPS  &mt RCTRL TAB  &lt 3 BSPC  &none  &none      &kp HOME  &kp END               &none
            >;
        };

        // Macの配列設定

        layer_1 {
            bindings = <
&none  &none              &none     &none      &none       &none                                  &none       &none  &none      &none     &none                 &none
&none  &kp Q              &kp W     &kp E      &kp R       &kp T                                  &kp Y       &kp U  &kp I      &kp O     &kp P                 &none
&none  &kp A              &kp S     &kp D      &kp F       &kp G        &none       &none         &kp H       &kp J  &kp K      &kp L     &lt 8 ENTER           &none
&none  &mt RIGHT_SHIFT Z  &kp X     &kp C      &kp V       &kp B        &kp ESC     &kp DELETE    &kp N       &kp M  &kp COMMA  &kp DOT   &mt RIGHT_SHIFT FSLH  &none
&none  &kp LGUI           &kp LALT  &kp LCTRL  &lt 3 BSPC  &lt 5 SPACE  &lt 6 CAPS  &mt RGUI TAB  &lt 3 BSPC  &none  &none      &kp HOME  &kp END               &none
            >;
        };

        layer_2 {
            bindings = <
&none  &none   &none   &none   &none   &none                   &none   &none      &none      &none      &none   &none
&none  &trans  &trans  &trans  &trans  &trans                  &trans  &trans     &trans     &trans     &trans  &none
&none  &trans  &trans  &trans  &trans  &trans  &none   &none   &trans  &mkp LCLK  &mkp MCLK  &mkp RCLK  &trans  &none
&none  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB4   &trans     &mkp MB5   &trans  &none
&none  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none      &none      &trans     &trans  &none
            >;
        };

        layer_3 {
            bindings = <
&none  &none       &none              &none       &none     &none                              &none             &none         &none     &none      &none                 &none
&none  &kp LS(N1)  &kp LS(EQUAL)      &kp F7      &kp F2    &kp LS(EQUAL)                      &kp LEFT_BRACKET  &kp LS(INT1)  &kp UP    &kp MINUS  &kp LS(N5)            &none
&none  &kp LS(N6)  &kp LS(N7)         &kp LS(N2)  &kp BSPC  &trans         &none       &none   &trans            &kp LEFT      &kp DOWN  &kp RIGHT  &kp F10               &none
&none  &kp LSHFT   &kp RIGHT_BRACKET  &kp BSLH    &trans    &trans         &trans      &trans  &kp LS(N3)        &kp LS(N4)    &kp APOS  &kp SEMI   &mt RIGHT_SHIFT INT3  &none
&none  &trans      &trans             &trans      &trans    &kp LS(N8)     &kp LS(N9)  &trans  &trans            &none         &none     &trans     &trans                &none
            >;
        };

        layer_4 {
            bindings = <
&none  &none   &none                 &none         &none              &none                   &none   &none   &none   &none   &none      &none
&none  &kp N1  &kp N2                &kp N3        &kp N4             &kp N5                  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0     &none
&none  &trans  &kp LC(LEFT_BRACKET)  &kp LEFT_ALT  &kp TAB            &trans  &none   &none   &trans  &kp N4  &kp N5  &kp N6  &kp MINUS  &none
&none  &trans  &kp LG(LC(LEFT))      &kp LG(TAB)   &kp LG(LC(RIGHT))  &trans  &trans  &trans  &kp N0  &kp N1  &kp N2  &kp N3  &kp DOT    &none
&none  &trans  &trans                &trans        &trans             &trans  &trans  &trans  &trans  &none   &none   &trans  &trans     &none
            >;
        };

        layer_5 {
            bindings = <
&none  &none   &none                 &none         &none          &none                   &none   &none   &none   &none   &none      &none
&none  &kp N1  &kp N2                &kp N3        &kp N4         &kp N5                  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0     &none
&none  &trans  &kp RC(LEFT_BRACKET)  &kp LEFT_ALT  &kp TAB        &trans  &none   &none   &trans  &kp N4  &kp N5  &kp N6  &kp MINUS  &none
&none  &trans  &kp RC(LEFT)          &kp RC(UP)    &kp RC(RIGHT)  &trans  &trans  &trans  &kp N0  &kp N1  &kp N2  &kp N3  &kp DOT    &none
&none  &trans  &trans                &trans        &trans         &trans  &trans  &trans  &trans  &none   &none   &trans  &trans     &none
            >;
        };

        layer_6 {
            bindings = <
&none  &none    &none    &none   &none   &none                   &none   &none     &none   &none    &none    &none
&none  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5                  &kp F6  &kp F7    &kp F8  &kp F9   &kp F10  &none
&none  &kp F11  &kp F12  &trans  &trans  &trans  &none   &none   &trans  &kp HOME  &trans  &kp END  &trans   &none
&none  &trans   &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans   &trans   &none
&none  &trans   &trans   &trans  &trans  &trans  &trans  &trans  &trans  &none     &none   &trans   &trans   &none
            >;
        };

        // WINDOWS スクロールレイヤー

        layer_7 {
            bindings = <
&none  &none          &none         &none         &none         &none                         &none   &none         &none       &none         &none   &none
&none  &bt BT_SEL 0   &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                  &trans  &trans        &trans      &trans        &trans  &none
&none  &bt BT_DISC 0  &trans        &trans        &trans        &trans        &none   &none   &trans  &trans        &trans      &trans        &trans  &none
&none  &trans         &trans        &trans        &trans        &trans        &trans  &trans  &trans  &kp C_VOL_DN  &kp C_MUTE  &kp C_VOL_UP  &trans  &none
&none  &bt BT_CLR     &trans        &trans        &trans        &trans        &trans  &trans  &trans  &none         &none       &trans        &trans  &none
            >;
        };

        // MAC スクロールレイヤー

        layer_8 {
            bindings = <
&none  &none         &none         &none         &none         &none                         &none   &none         &none       &none         &none   &none
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                  &trans  &trans        &trans      &trans        &trans  &none
&none  &trans        &trans        &trans        &trans        &trans        &none   &none   &trans  &trans        &trans      &trans        &trans  &none
&none  &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans  &kp C_VOL_DN  &kp C_MUTE  &kp C_VOL_UP  &trans  &none
&none  &bt BT_CLR    &trans        &trans        &trans        &trans        &trans  &trans  &trans  &none         &none       &trans        &trans  &none
            >;
        };

        layer_9 {
            bindings = <
&none  &none   &none   &none   &none   &none                   &none   &none   &none   &none   &none   &none
&none  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &none
&none  &trans  &trans  &trans  &trans  &trans  &none   &none   &trans  &trans  &trans  &trans  &trans  &none
&none  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none
&none  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none   &none   &trans  &trans  &none
            >;
        };

        layer_10 {
            bindings = <
&none  &none   &none   &none   &none   &none                   &none   &none   &none   &none   &none   &none
&none  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &none
&none  &trans  &trans  &trans  &trans  &trans  &none   &none   &trans  &trans  &trans  &trans  &trans  &none
&none  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none
&none  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none   &none   &trans  &trans  &none
            >;
        };

        layer_11 {
            bindings = <
&none  &none   &none   &none   &none   &none                   &none   &none   &none   &none   &none   &none
&none  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &none
&none  &trans  &trans  &trans  &trans  &trans  &none   &none   &trans  &trans  &trans  &trans  &trans  &none
&none  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none
&none  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none   &none   &trans  &trans  &none
            >;
        };

        layer_12 {
            bindings = <
&none  &none   &none   &none   &none   &none                   &none   &none   &none   &none   &none   &none
&none  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &none
&none  &trans  &trans  &trans  &trans  &trans  &none   &none   &trans  &trans  &trans  &trans  &trans  &none
&none  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none
&none  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none   &none   &trans  &trans  &none
            >;
        };

        layer_13 {
            bindings = <
&none  &none   &none   &none   &none   &none                   &none   &none   &none   &none   &none   &none
&none  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &none
&none  &trans  &trans  &trans  &trans  &trans  &none   &none   &trans  &trans  &trans  &trans  &trans  &none
&none  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none
&none  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none   &none   &trans  &trans  &none
            >;
        };

        layer_14 {
            bindings = <
&none  &none   &none   &none   &none   &none                   &none   &none   &none   &none   &none   &none
&none  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &none
&none  &trans  &trans  &trans  &trans  &trans  &none   &none   &trans  &trans  &trans  &trans  &trans  &none
&none  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none
&none  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none   &none   &trans  &trans  &none
            >;
        };

        layer_15 {
            bindings = <
&none  &none   &none   &none   &none   &none                   &none   &none   &none   &none   &none   &none
&none  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &none
&none  &trans  &trans  &trans  &trans  &trans  &none   &none   &trans  &trans  &trans  &trans  &trans  &none
&none  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none
&none  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none   &none   &trans  &trans  &none
            >;
        };
    };
};

&mt { flavor = "balanced"; };

&lt { flavor = "balanced"; };
