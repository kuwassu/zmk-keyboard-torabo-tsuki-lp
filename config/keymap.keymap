#include <mouse-gesture.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define FUNC         0x36  // Function

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <53 54 55>;
            layers = <10 11>;
        };

        bt_clear_all {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <13 14 15 16>;
            layers = <10 11>;
        };

        mac_layout {
            bindings = <&to 1>;
            key-positions = <13 14 15>;
            layers = <0 1 10 11>;
        };

        win_layout {
            bindings = <&to 0>;
            key-positions = <13 14>;
            layers = <0 1 10 11>;
        };

        left_kakko {
            bindings = <&kp LS(N8)>;
            key-positions = <19 20>;
            layers = <0 1>;
        };

        right_kakko {
            bindings = <&kp LS(N9)>;
            key-positions = <20 21>;
            layers = <0 1>;
        };

        left_namikakko {
            bindings = <&kp LS(RIGHT_BRACKET)>;
            key-positions = <19 20>;
            layers = <4 5>;
        };

        right_namikakko {
            bindings = <&kp LS(BSLH)>;
            key-positions = <20 21>;
            layers = <4 5>;
        };

        left_kakukakko {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <47 48>;
            layers = <4 5>;
        };

        right_kakukako {
            bindings = <&kp BSLH>;
            key-positions = <48 49>;
            layers = <4 5>;
        };

        semicolon {
            bindings = <&kp SEMI>;
            key-positions = <33 34>;
            layers = <10 11>;
        };

        colon {
            bindings = <&kp APOS>;
            key-positions = <34 35>;
            layers = <10 11>;
        };

        plus {
            bindings = <&kp LS(SEMI)>;
            key-positions = <33 34>;
            layers = <4 5>;
        };

        asterisk {
            bindings = <&kp LS(APOS)>;
            key-positions = <34 35>;
            layers = <4 5>;
        };

        left_click {
            bindings = <&mkp LCLK>;
            key-positions = <33 34>;
            layers = <0 1 2 3 12>;
        };

        right_click {
            bindings = <&mkp RCLK>;
            key-positions = <34 35>;
            layers = <0 1 2 3 12>;
        };

        middle_click {
            bindings = <&mkp MCLK>;
            key-positions = <33 34 35>;
            layers = <0 1 2 3 12>;
        };

        undo_click {
            bindings = <&mkp MB4>;
            key-positions = <47 48>;
            layers = <0 1 2 3 12>;
        };

        redo_click {
            bindings = <&mkp MB5>;
            key-positions = <48 49>;
            layers = <0 1 2 3 12>;
        };

        slow_mouse_layer {
            bindings = <&mo 3>;
            key-positions = <47 48 49>;
            layers = <0 1 2 3 12>;
        };

        kana {
            bindings = <&kp LANGUAGE_1>;
            key-positions = <27 28>;
            layers = <0 1 6 7>;
        };

        eisu {
            bindings = <&kp LANG2>;
            key-positions = <26 27>;
            layers = <0 1 6 7>;
        };

        win_win {
            bindings = <&kp LGUI>;
            key-positions = <26 27 28>;
            layers = <0 6>;
        };

        mac_ctrl {
            bindings = <&kp RCTRL>;
            key-positions = <26 27 28>;
            layers = <1 7>;
        };
    };

    macros {
        mac_windows_large: mac_windows_large {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp RCTRL &kp CAPS>,
                <&macro_tap>,
                <&kp F>,
                <&macro_release>,
                <&kp RCTRL &kp CAPS>;

            label = "MAC_WINDOWS_LARGE";
        };

        mac_windows_left: mac_windows_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp RCTRL &kp CAPS>,
                <&macro_tap>,
                <&kp LEFT>,
                <&macro_release>,
                <&kp RCTRL &kp CAPS>;

            label = "MAC_WINDOWS_LEFT";
        };

        mac_windows_right: mac_windows_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp RCTRL &kp CAPS>,
                <&macro_tap>,
                <&kp RIGHT>,
                <&macro_release>,
                <&kp RCTRL &kp CAPS>;

            label = "MAC_WINDOWS_RIGHT";
        };

        mac_windows_small: mac_windows_small {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp RCTRL &kp CAPS>,
                <&macro_tap>,
                <&kp C>,
                <&macro_release>,
                <&kp RCTRL &kp CAPS>;

            label = "MAC_WINDOWS_SMALL";
        };

        win_bt0: win_bt0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &to 0>;
            label = "WIN_BT0";
        };

        mac_bt1: mac_bt1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &to 1>;
            label = "MAC_BT1";
        };

        win_bt2: win_bt2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2 &to 0>;
            label = "WIN_BT2";
        };

        mac_bt3: mac_bt3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3 &to 1>;
            label = "MAC_BT3";
        };

        win_bt4: win_bt4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4 &to 0>;
            label = "WIN_BT4";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        L0_win_default {
            bindings = <
&none  &none              &none     &none     &none        &none                                    &none       &none  &none      &none     &none                 &none
&none  &kp Q              &kp W     &kp E     &kp R        &kp T                                    &kp Y       &kp U  &kp I      &kp O     &kp P                 &none
&none  &kp A              &kp S     &kp D     &kp F        &kp G        &none        &none          &kp H       &kp J  &kp K      &kp L     &lt 10 ENTER          &none
&none  &mt RIGHT_SHIFT Z  &kp X     &kp C     &kp V        &kp B        &kp ESC      &kp DELETE     &kp N       &kp M  &kp COMMA  &kp DOT   &mt RIGHT_SHIFT FSLH  &none
&none  &kp LCTRL          &kp LGUI  &kp LALT  &lt 12 BSPC  &lt 6 SPACE  &lt 8 GRAVE  &mt RCTRL TAB  &lt 4 BSPC  &none  &none      &kp HOME  &kp END               &none
            >;
        };

        L1_mac_default {
            bindings = <
&none  &none              &none     &none              &none        &none                                       &none       &none  &none      &none         &none                 &none
&none  &kp Q              &kp W     &kp E              &kp R        &kp T                                       &kp Y       &kp U  &kp I      &kp O         &kp P                 &none
&none  &kp A              &kp S     &kp D              &kp F        &kp G        &none        &none             &kp H       &kp J  &kp K      &kp L         &lt 11 ENTER          &none
&none  &mt RIGHT_SHIFT Z  &kp X     &kp C              &kp V        &kp B        &kp ESC      &kp LG(BSPC)      &kp N       &kp M  &kp COMMA  &kp DOT       &mt RIGHT_SHIFT FSLH  &none
&none  &kp LGUI           &kp LALT  &kp RIGHT_CONTROL  &lt 12 BSPC  &lt 7 SPACE  &lt 9 LCTRL  &mt LEFT_GUI TAB  &lt 5 BSPC  &none  &none      &kp LG(LEFT)  &kp LG(RIGHT)         &none
            >;
        };

        L2_auto_mouse {
            bindings = <
&none  &none   &none   &none   &none   &none                   &none   &none      &none      &none      &none   &none
&none  &trans  &trans  &trans  &trans  &trans                  &trans  &trans     &trans     &trans     &trans  &none
&none  &mo 3   &trans  &trans  &trans  &trans  &none   &none   &trans  &mkp LCLK  &mkp MCLK  &mkp RCLK  &trans  &none
&none  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB4   &trans     &mkp MB5   &trans  &none
&none  &trans  &trans  &trans  &mo 12  &trans  &trans  &trans  &trans  &none      &none      &trans     &mo 3   &none
            >;
        };

        L3_slow_mouse {
            bindings = <
&none  &none   &none      &none      &none      &none                   &none   &none      &none      &none      &none   &none
&none  &trans  &trans     &trans     &trans     &trans                  &trans  &trans     &trans     &trans     &trans  &none
&none  &mo 3   &mkp LCLK  &mkp MCLK  &mkp RCLK  &trans  &none   &none   &trans  &mkp LCLK  &mkp MCLK  &mkp RCLK  &trans  &none
&none  &trans  &mkp MB4   &trans     &mkp MB5   &trans  &trans  &trans  &trans  &mkp MB4   &trans     &mkp MB5   &trans  &none
&none  &trans  &trans     &trans     &mo 12     &trans  &trans  &trans  &trans  &none      &none      &trans     &mo 3   &none
            >;
        };

        L4_win_right_thumb {
            bindings = <
&none  &none                 &none          &none       &none      &none                                       &none       &none         &none     &none      &none            &none
&none  &kp LS(N1)            &kp LS(EQUAL)  &kp F7      &kp F2     &kp LS(EQUAL)                               &kp LC(Y)   &kp LS(INT1)  &kp UP    &kp MINUS  &kp LS(N5)       &none
&none  &kp LS(N6)            &kp LS(N7)     &kp LS(N2)  &kp BSPC   &kp LBKT       &none              &none     &kp EQUAL   &kp LEFT      &kp DOWN  &kp RIGHT  &kp F10          &none
&none  &mt LEFT_SHIFT LC(Z)  &kp LC(X)      &kp LC(C)   &kp LC(V)  &kp INT3       &kp RIGHT_BRACKET  &kp BSLH  &kp LS(N3)  &kp LS(N4)    &kp SEMI  &kp APOS   &kp RIGHT_SHIFT  &none
&none  &trans                &trans         &trans      &trans     &kp LS(SPACE)  &trans             &trans    &trans      &none         &none     &trans     &trans           &none
            >;
        };

        L5_mac_right_thumb {
            bindings = <
&none  &none                 &none          &none       &none      &none                                       &none          &none         &none     &none      &none            &none
&none  &kp LS(N1)            &kp LS(EQUAL)  &kp F7      &kp F2     &kp LS(EQUAL)                               &kp LG(LS(Z))  &kp LS(INT1)  &kp UP    &kp MINUS  &kp LS(N5)       &none
&none  &kp LS(N6)            &kp LS(N7)     &kp LS(N2)  &kp BSPC   &kp LBKT       &none              &none     &kp EQUAL      &kp LEFT      &kp DOWN  &kp RIGHT  &kp F10          &none
&none  &mt LEFT_SHIFT LG(Z)  &kp LG(X)      &kp LG(C)   &kp LG(V)  &kp INT3       &kp RIGHT_BRACKET  &kp BSLH  &kp LS(N3)     &kp LS(N4)    &kp SEMI  &kp APOS   &kp RIGHT_SHIFT  &none
&none  &trans                &trans         &trans      &trans     &kp LS(SPACE)  &trans             &trans    &trans         &none         &none     &trans     &trans           &none
            >;
        };

        L6_win_left_thumb2 {
            bindings = <
&none  &none         &none             &none         &none              &none                       &none         &none   &none   &none   &none      &none
&none  &kp N1        &kp N2            &kp N3        &kp N4             &kp N5                      &kp N6        &kp N7  &kp N8  &kp N9  &kp N0     &none
&none  &kp LC(LBKT)  &kp LS(TAB)       &kp LEFT_ALT  &kp TAB            &trans  &none   &none       &kp LS(SEMI)  &kp N4  &kp N5  &kp N6  &kp MINUS  &none
&none  &trans        &kp LG(LC(LEFT))  &kp LG(TAB)   &kp LG(LC(RIGHT))  &trans  &trans  &kp PERIOD  &kp LS(APOS)  &kp N1  &kp N2  &kp N3  &kp SLASH  &none
&none  &trans        &trans            &trans        &trans             &trans  &trans  &trans      &trans        &none   &none   &kp N0  &trans     &none
            >;
        };

        L7_mac_left_thumb2 {
            bindings = <
&none  &none          &none         &none         &none          &none                       &none         &none   &none   &none   &none      &none
&none  &kp N1         &kp N2        &kp N3        &kp N4         &kp N5                      &kp N6        &kp N7  &kp N8  &kp N9  &kp N0     &none
&none  &kp RC(LBKT)   &kp LSHIFT    &kp LEFT_ALT  &kp TAB        &trans  &none   &none       &kp LS(SEMI)  &kp N4  &kp N5  &kp N6  &kp MINUS  &none
&none  &kp LS(LG(C))  &kp RC(LEFT)  &kp RC(UP)    &kp RC(RIGHT)  &trans  &trans  &kp PERIOD  &kp LS(APOS)  &kp N1  &kp N2  &kp N3  &kp SLASH  &none
&none  &trans         &trans        &trans        &trans         &trans  &trans  &trans      &trans        &none   &none   &kp N0  &trans     &none
            >;
        };

        L8_win_left_thub3 {
            bindings = <
&none  &none    &none    &none   &none   &none                   &none       &none   &none   &none     &none            &none
&none  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5                  &kp F6      &kp F7  &kp F8  &kp F9    &kp F10          &none
&none  &kp F11  &kp F12  &trans  &trans  &trans  &none   &none   &kp LA(F4)  &trans  &trans  &kp CAPS  &kp PRINTSCREEN  &none
&none  &trans   &trans   &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans           &none
&none  &trans   &trans   &trans  &trans  &trans  &trans  &trans  &trans      &none   &none   &trans    &trans           &none
            >;
        };

        L9_mac_left_thub3 {
            bindings = <
&none  &none    &none    &none   &none   &none                   &none      &none   &none   &none     &none          &none
&none  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5                  &kp F6     &kp F7  &kp F8  &kp F9    &kp F10        &none
&none  &kp F11  &kp F12  &trans  &trans  &trans  &none   &none   &kp LG(Q)  &trans  &trans  &kp CAPS  &kp LG(LS(4))  &none
&none  &trans   &trans   &trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans    &trans         &none
&none  &trans   &trans   &trans  &trans  &trans  &trans  &trans  &trans     &none   &none   &trans    &trans         &none
            >;
        };

        L10_win_scroll_BT {
            bindings = <
&none  &none          &none          &none          &none          &none                                    &none   &none         &none       &none         &none   &none
&none  &win_bt0       &mac_bt1       &win_bt2       &mac_bt3       &win_bt4                                 &trans  &trans        &trans      &trans        &trans  &none
&none  &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4  &none   &none             &trans  &trans        &trans      &kp LCTRL     &trans  &none
&none  &trans         &trans         &trans         &trans         &trans         &trans  &trans            &trans  &kp C_VOL_DN  &kp C_MUTE  &kp C_VOL_UP  &trans  &none
&none  &bt BT_PRV     &trans         &bt BT_NXT     &trans         &trans         &trans  &kp C_PLAY_PAUSE  &trans  &none         &none       &trans        &trans  &none
            >;
        };

        L11_mac_scroll_BT {
            bindings = <
&none  &none          &none          &none          &none          &none                                    &none   &none         &none       &none         &none   &none
&none  &win_bt0       &mac_bt1       &win_bt2       &mac_bt3       &win_bt4                                 &trans  &trans        &trans      &trans        &trans  &none
&none  &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4  &none   &none             &trans  &trans        &trans      &kp RCTRL     &trans  &none
&none  &trans         &trans         &trans         &trans         &trans         &trans  &trans            &trans  &kp C_VOL_DN  &kp C_MUTE  &kp C_VOL_UP  &trans  &none
&none  &bt BT_PRV     &trans         &bt BT_NXT     &trans         &trans         &trans  &kp C_PLAY_PAUSE  &trans  &none         &none       &trans        &trans  &none
            >;
        };

        L12_mouse {
            bindings = <
&none  &none   &none      &none      &none      &none                   &none   &none      &none      &none      &none   &none
&none  &trans  &trans     &trans     &trans     &trans                  &trans  &trans     &trans     &trans     &trans  &none
&none  &mo 3   &mkp LCLK  &mkp MCLK  &mkp RCLK  &trans  &none   &none   &trans  &mkp LCLK  &mkp MCLK  &mkp RCLK  &trans  &none
&none  &trans  &mkp MB4   &trans     &mkp MB5   &trans  &trans  &trans  &trans  &mkp MB4   &trans     &mkp MB5   &trans  &none
&none  &trans  &trans     &trans     &trans     &trans  &trans  &trans  &trans  &none      &none      &trans     &mo 3   &none
            >;
        };
    };
};

&zip_win_mouse_gesture {
    stroke-size = <100>;
    enable-eager-mode;
    always-active;
    gesture-cooldown-ms = <100>;

    window_left {
        pattern = <GESTURE_LEFT>;
        bindings = <&kp LG(LEFT)>;
    };

    window_right {
        pattern = <GESTURE_RIGHT>;
        bindings = <&kp LG(RIGHT)>;
    };

    window_small {
        pattern = <GESTURE_DOWN>;
        bindings = <&kp LG(DOWN)>;
    };

    window_large {
        pattern = <GESTURE_UP>;
        bindings = <&kp LG(UP)>;
    };
};

&zip_mac_mouse_gesture {
    stroke-size = <100>;
    enable-eager-mode;
    always-active;
    gesture-cooldown-ms = <100>;

    window_left {
        pattern = <GESTURE_LEFT>;
        bindings = <&mac_windows_left>;
    };

    window_right {
        pattern = <GESTURE_RIGHT>;
        bindings = <&mac_windows_right>;
    };

    window_small {
        pattern = <GESTURE_DOWN>;
        bindings = <&mac_windows_small>;
    };

    window_large {
        pattern = <GESTURE_UP>;
        bindings = <&mac_windows_large>;
    };
};

&mt { flavor = "balanced"; };

&lt {
    flavor = "hold-preferred";
    quick-tap-ms = <50>;
};
