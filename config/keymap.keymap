#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <13 14 15 16>;
            layers = <7 8>;
        };

        mac_layout {
            bindings = <&to 1>;
            key-positions = <16 17>;
            layers = <0>;
        };

        win_layout {
            bindings = <&to 0>;
            key-positions = <13 14>;
            layers = <1>;
        };

        left_kakko {
            bindings = <&kp LS(N8)>;
            key-positions = <33 34>;
            layers = <0 1>;
        };

        right_kakko {
            bindings = <&kp LS(N9)>;
            key-positions = <34 35>;
            layers = <0 1>;
        };

        left_namikakko {
            bindings = <&kp LS(RIGHT_BRACKET)>;
            key-positions = <19 20>;
            layers = <0 1>;
        };

        right_namikakko {
            bindings = <&kp LS(BSLH)>;
            key-positions = <20 21>;
            layers = <0 1>;
        };

        left_kakukakko {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <47 48>;
            layers = <0 1>;
        };

        right_kakukako {
            bindings = <&kp BSLH>;
            key-positions = <49 48>;
            layers = <0 1>;
        };

        semicolon {
            bindings = <&kp SEMI>;
            key-positions = <34 33>;
            layers = <3>;
        };

        colon {
            bindings = <&kp APOS>;
            key-positions = <36 35>;
            layers = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        L0_win_default {
            bindings = <
&none  &none              &none     &none     &none       &none                                   &none       &none  &none      &none     &none                 &none
&none  &kp Q              &kp W     &kp E     &kp R       &kp T                                   &kp Y       &kp U  &kp I      &kp O     &kp P                 &none
&none  &kp A              &kp S     &kp D     &kp F       &kp G        &none       &none          &kp H       &kp J  &kp K      &kp L     &lt 7 ENTER           &none
&none  &mt RIGHT_SHIFT Z  &kp X     &kp C     &kp V       &kp B        &kp ESC     &kp DELETE     &kp N       &kp M  &kp COMMA  &kp DOT   &mt RIGHT_SHIFT FSLH  &none
&none  &kp LCTRL          &kp LGUI  &kp LALT  &lt 2 BSPC  &lt 4 SPACE  &lt 6 CAPS  &mt RCTRL TAB  &lt 3 BSPC  &none  &none      &kp HOME  &kp END               &none
            >;
        };

        L1_mac_default {
            bindings = <
&none  &none              &none     &none              &none        &none                                      &none       &none  &none      &none     &none                 &none
&none  &kp Q              &kp W     &kp E              &kp R        &kp T                                      &kp Y       &kp U  &kp I      &kp O     &kp P                 &none
&none  &kp A              &kp S     &kp D              &kp F        &kp G        &none       &none             &kp H       &kp J  &kp K      &kp L     &lt 8 ENTER           &none
&none  &mt RIGHT_SHIFT Z  &kp X     &kp C              &kp V        &kp B        &kp ESC     &kp DELETE        &kp N       &kp M  &kp COMMA  &kp DOT   &mt RIGHT_SHIFT FSLH  &none
&none  &kp LGUI           &kp LALT  &kp RIGHT_CONTROL  &lt 10 BSPC  &lt 5 SPACE  &lt 6 CAPS  &mt LEFT_GUI TAB  &lt 3 BSPC  &none  &none      &kp HOME  &kp END               &none
            >;
        };

        L2_auto_mouse {
            bindings = <
&none  &none   &none      &none      &none      &none                   &none   &none      &none      &none      &none   &none
&none  &trans  &trans     &trans     &trans     &trans                  &trans  &trans     &trans     &trans     &trans  &none
&none  &mo 3   &mkp LCLK  &mkp MCLK  &mkp RCLK  &trans  &none   &none   &trans  &mkp LCLK  &mkp MCLK  &mkp RCLK  &trans  &none
&none  &trans  &mkp MB4   &trans     &mkp MB5   &trans  &trans  &trans  &trans  &mkp MB4   &trans     &mkp MB5   &trans  &none
&none  &trans  &trans     &trans     &mo 2      &trans  &trans  &trans  &trans  &none      &none      &trans     &mo 3   &none
            >;
        };

        L3_slow_mouse {
            bindings = <
&none  &none   &none      &none      &none      &none                   &none   &none      &none      &none      &none   &none
&none  &trans  &trans     &trans     &trans     &trans                  &trans  &trans     &trans     &trans     &trans  &none
&none  &mo 3   &mkp LCLK  &mkp MCLK  &mkp RCLK  &trans  &none   &none   &trans  &mkp LCLK  &mkp MCLK  &mkp RCLK  &trans  &none
&none  &trans  &mkp MB4   &trans     &mkp MB5   &trans  &trans  &trans  &trans  &mkp MB4   &trans     &mkp MB5   &trans  &none
&none  &trans  &trans     &trans     &mo 2      &trans  &trans  &trans  &trans  &none      &none      &trans     &mo 3   &none
            >;
        };

        L4_win_right_thumb {
            bindings = <
&none  &none                 &none          &none       &none      &none                          &none             &none         &none     &none      &none            &none
&none  &kp LS(N1)            &kp LS(EQUAL)  &kp F7      &kp F2     &kp LS(EQUAL)                  &kp LEFT_BRACKET  &kp LS(INT1)  &kp UP    &kp MINUS  &kp LS(N5)       &none
&none  &kp LS(N6)            &kp LS(N7)     &kp LS(N2)  &kp BSPC   &trans         &none   &none   &kp EQUAL         &kp LEFT      &kp DOWN  &kp RIGHT  &kp F10          &none
&none  &mt LEFT_SHIFT LC(Z)  &kp LC(X)      &kp LC(C)   &kp LC(V)  &kp INT3       &trans  &trans  &kp LS(N3)        &kp LS(N4)    &kp APOS  &kp SEMI   &kp RIGHT_SHIFT  &none
&none  &trans                &trans         &trans      &trans     &trans         &trans  &trans  &trans            &none         &none     &trans     &trans           &none
            >;
        };

        L5_mac_right_thumb {
            bindings = <
&none  &none                 &none          &none       &none      &none                          &none             &none         &none     &none      &none            &none
&none  &kp LS(N1)            &kp LS(EQUAL)  &kp F7      &kp F2     &kp LS(EQUAL)                  &kp LEFT_BRACKET  &kp LS(INT1)  &kp UP    &kp MINUS  &kp LS(N5)       &none
&none  &kp LS(N6)            &kp LS(N7)     &kp LS(N2)  &kp BSPC   &trans         &none   &none   &kp EQUAL         &kp LEFT      &kp DOWN  &kp RIGHT  &kp F10          &none
&none  &mt LEFT_SHIFT LG(Z)  &kp LG(X)      &kp LG(C)   &kp LG(V)  &kp INT3       &trans  &trans  &kp LS(N3)        &kp LS(N4)    &kp APOS  &kp SEMI   &kp RIGHT_SHIFT  &none
&none  &trans                &trans         &trans      &trans     &trans         &trans  &trans  &trans            &none         &none     &trans     &trans           &none
            >;
        };

        L6_win_left_thumb2 {
            bindings = <
&none  &none   &none                 &none         &none              &none                   &none   &none   &none   &none   &none      &none
&none  &kp N1  &kp N2                &kp N3        &kp N4             &kp N5                  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0     &none
&none  &trans  &kp LC(LEFT_BRACKET)  &kp LEFT_ALT  &kp TAB            &trans  &none   &none   &trans  &kp N4  &kp N5  &kp N6  &kp MINUS  &none
&none  &trans  &kp LG(LC(LEFT))      &kp LG(TAB)   &kp LG(LC(RIGHT))  &trans  &trans  &trans  &kp N0  &kp N1  &kp N2  &kp N3  &kp DOT    &none
&none  &trans  &trans                &trans        &trans             &trans  &trans  &trans  &trans  &none   &none   &trans  &trans     &none
            >;
        };

        L7_mac_left_thumb2 {
            bindings = <
&none  &none   &none                 &none         &none          &none                   &none   &none   &none   &none   &none      &none
&none  &kp N1  &kp N2                &kp N3        &kp N4         &kp N5                  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0     &none
&none  &trans  &kp RC(LEFT_BRACKET)  &kp LEFT_ALT  &kp TAB        &trans  &none   &none   &trans  &kp N4  &kp N5  &kp N6  &kp MINUS  &none
&none  &trans  &kp RC(LEFT)          &kp RC(UP)    &kp RC(RIGHT)  &trans  &trans  &trans  &kp N0  &kp N1  &kp N2  &kp N3  &kp DOT    &none
&none  &trans  &trans                &trans        &trans         &trans  &trans  &trans  &trans  &none   &none   &trans  &trans     &none
            >;
        };

        L8_left_thub3 {
            bindings = <
&none  &none    &none    &none   &none   &none                   &none   &none     &none   &none    &none    &none
&none  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5                  &kp F6  &kp F7    &kp F8  &kp F9   &kp F10  &none
&none  &kp F11  &kp F12  &trans  &trans  &trans  &none   &none   &trans  &kp HOME  &trans  &kp END  &trans   &none
&none  &trans   &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans   &trans   &none
&none  &trans   &trans   &trans  &trans  &trans  &trans  &trans  &trans  &none     &none   &trans   &trans   &none
            >;
        };

        L9_win_scroll_BT {
            bindings = <
&none  &none          &none          &none          &none          &none                          &none       &none         &none       &none         &none   &none
&none  &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4                   &trans      &trans        &trans      &trans        &trans  &none
&none  &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4  &none   &none   &trans      &trans        &trans      &trans        &trans  &none
&none  &trans         &trans         &trans         &trans         &trans         &trans  &trans  &trans      &kp C_VOL_DN  &kp C_MUTE  &kp C_VOL_UP  &trans  &none
&none  &bt BT_CLR     &trans         &trans         &trans         &trans         &trans  &trans  &kp C_PLAY  &none         &none       &trans        &trans  &none
            >;
        };

        L10_mac_scroll_BT {
            bindings = <
&none  &none          &none          &none          &none          &none                          &none       &none         &none       &none         &none   &none
&none  &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4                   &trans      &trans        &trans      &trans        &trans  &none
&none  &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4  &none   &none   &trans      &trans        &trans      &trans        &trans  &none
&none  &trans         &trans         &trans         &trans         &trans         &trans  &trans  &trans      &kp C_VOL_DN  &kp C_MUTE  &kp C_VOL_UP  &trans  &none
&none  &bt BT_CLR     &trans         &trans         &trans         &trans         &trans  &trans  &kp C_PLAY  &none         &none       &trans        &trans  &none
            >;
        };

        L9_mouse {
            bindings = <
&none  &none   &none      &none      &none      &none                   &none   &none      &none      &none      &none   &none
&none  &trans  &trans     &trans     &trans     &trans                  &trans  &trans     &trans     &trans     &trans  &none
&none  &trans  &mkp LCLK  &mkp MCLK  &mkp RCLK  &trans  &none   &none   &trans  &mkp LCLK  &mkp MCLK  &mkp RCLK  &trans  &none
&none  &trans  &mkp MB4   &trans     &mkp MB5   &trans  &trans  &trans  &trans  &mkp MB4   &trans     &mkp MB5   &trans  &none
&none  &trans  &trans     &trans     &trans     &trans  &trans  &trans  &trans  &none      &none      &trans     &mo 9   &none
            >;
        };
    };
};

&mt { flavor = "balanced"; };

&lt { flavor = "balanced"; };
